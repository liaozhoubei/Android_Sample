<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. 声明权限 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera.any" />
    <!-- 2. 显式指定相机硬件为非必需 -->
    <!-- <uses-feature -->
    <!-- android:name="android.hardware.camera" -->
    <!-- android:required="false" /> -->


    <!-- 如果你还需要支持自动对焦等功能，也建议加上 -->
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Android 10 及以下所需的传统读写权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11+ 所需的所有文件访问权限 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 从 Android 11 开始, 需要用 queries 允许查询处理图片裁剪 Intent 的应用 -->
    <queries>
        <intent>
            <action android:name="com.android.camera.action.CROP" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Android_Example">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Splash"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="SplashScreenAttribute"> <!-- 忽略 SplashScreen 规范警告 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Android_Example"
            android:windowSoftInputMode="adjustResize" />

        <!-- 配置 FileProvider 适配 Android 7.0+ 地址暴露安全限制 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".CameraXActivity"
            android:exported="false"
            android:label="@string/title_activity_camera_xactivity"
            android:theme="@style/Theme.Android_Example"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CropActivity"
            android:exported="false"
            android:label="@string/title_activity_crop"
            android:theme="@style/Theme.Android_Example"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".FileExplorerActivity"
            android:exported="false"
            android:label="@string/title_activity_file_explorer"
            android:theme="@style/Theme.Android_Example"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AdaptiveLayoutActivity"
            android:exported="false"
            android:label="@string/title_activity_adaptive_layout"
            android:theme="@style/Theme.Android_Example"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>